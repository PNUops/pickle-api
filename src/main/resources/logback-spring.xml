<?xml version="1.0" encoding="UTF-8"?>
<!-- Console logging with secret masking (%maskedMsg for messages, %maskedEx
     for stack traces): password/token/secret/cipassword values never appear
     raw in log output. -->
<configuration>
    <conversionRule conversionWord="maskedMsg"
                    class="kr.ac.pusan.pickle.common.logging.MaskingMessageConverter"/>
    <conversionRule conversionWord="maskedEx"
                    class="kr.ac.pusan.pickle.common.logging.MaskingThrowableConverter"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p ${PID:- } --- [%15.15t] %-40.40logger{39} : %maskedMsg%n%maskedEx</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
